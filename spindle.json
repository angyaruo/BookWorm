{
  "version": "2.2.0",
  "name": "BookWorm",
  "identifier": "lumiverse_bookworm",
  "description": "Your miniature writing companion: an offline English dictionary and thesaurus, plus model-assisted research, translation, and story advice.",
  "author": "angyaruo",
  "permissions": [
    "generation",
    "chats",
    "ui_panels",
    "web_search"
  ],
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "github": "https://github.com/angyaruo/BookWorm",
  "homepage": "https://github.com/angyaruo/BookWorm",
  "storage_seed_files": [
    { "from": "data/lexicon/", "to": "lexicon/", "overwrite": true, "required": true },
    { "from": "licenses/", "to": "licenses/", "overwrite": true, "required": true }
  ]
}
